{
  "editor.formatOnSave": true,
  "[ocaml]": { "editor.defaultFormatter": "ocamllabs.ocaml-platform" },

  // Bouton ▶ (Code Runner) : compile et exécute le fichier ouvert via dune.
  "code-runner.executorMap": {
    "ocaml": "cd $dir && dune exec ./$fileNameWithoutExt.exe"
  },
  "code-runner.runInTerminal": true,

  "code-runner.clearPreviousOutput": true
}
